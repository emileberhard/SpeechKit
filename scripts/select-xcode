#!/bin/bash
set -euo pipefail

version=$(<"$(dirname "$0")/../.xcode-version")
for app in /Applications/Xcode*.app; do
  if [[ $(plutil -extract CFBundleShortVersionString raw "$app/Contents/Info.plist" 2>/dev/null) == "$version" ]]; then
    echo "DEVELOPER_DIR=$app/Contents/Developer" >> "$GITHUB_ENV"
    exit 0
  fi
done
echo "::error::Xcode $version from .xcode-version is not installed on this runner."
exit 1
